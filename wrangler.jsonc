{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marathontracking",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "."
  }
}
